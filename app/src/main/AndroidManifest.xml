<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      存储权限已全部移除：模型统一放在应用专属目录（getExternalFilesDir("models")），
      用户导入走 SAF 单次授权。targetSdk >= 33 之后 .bin/.moc3/.model3.json 这类非媒体文件
      本来也没有任何运行时权限能授予访问，READ_EXTERNAL_STORAGE 和 READ_MEDIA_* 都不适用。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:name=".application.ChatWaifuApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Design.NoActionBar">
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          正式前台（T1：由 debug-only 的 CompanionDemoActivity 提升而来）。
          adjustResize 是 Phase 1 真机修过的 IME 缺陷（输入条被键盘挡住），不能删。
        -->
        <activity
            android:name=".ui.companion.CompanionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 二级页面宿主（角色 / 记录 / 记忆 / 设置），只从 Companion 的「更多」进入 -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
